{
  "manifest_version": 3,
  "name": "PhishGuard: DLP & Anti-Phish",
  "version": "1.0",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://mail.google.com/*", "https://athulmenondev-epds.hf.space/*"],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["asset-manifest.json", "static/js/*.js", "static/css/*.css", "logo.png"],
      "matches": ["https://mail.google.com/*"]
    }
  ]
}