{
  "manifest_version": 3,
  "name": "PhishGuard: DLP & Anti-Phish",
  "version": "1.0",
  "description": "Protects against phishing and data leaks in Gmail.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://athulmenondev-epds.hf.space/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["sidebar.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "logo.png",
        "build/asset-manifest.json",
        "build/static/js/*.js",
        "build/static/css/*.css",
        "build/logo.png"
      ],
      "matches": ["https://mail.google.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}