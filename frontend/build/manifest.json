{
  "manifest_version": 3,
  "name": "PhishGuard",
  "version": "1.0",
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "asset-manifest.json",
        "static/js/*.js",
        "static/css/*.css",
        "logo.png"
      ],
      "matches": ["https://mail.google.com/*"]
    }
  ]
}